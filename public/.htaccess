DirectoryIndex index.html
ErrorDocument 404 /404.html
# Les routes applicatives restent sans slash, même si un dossier porte leur nom.
# Désactiver le listing lorsque la redirection automatique des dossiers est coupée.
Options -Indexes
DirectorySlash Off

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Réécrire aussi /realisations, qui est le nom d'un dossier de fiches projet.
  # Nécessaire avec DirectorySlash Off pour appliquer les règles à ce dossier.
  RewriteOptions AllowNoSlash

  # Une seule origine publique : HTTPS sans www. Ne pas rediriger les aperçus locaux.
  # La destination est fixe : aucun domaine fourni par le navigateur n'est réutilisé.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?ecgplusgn\.com(?::[0-9]+)?$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  # Laisser Apache encoder les caractères spéciaux du chemin dans Location.
  RewriteRule ^ https://ecgplusgn.com%{REQUEST_URI} [R=301,L]

  # Une seule URL publique par page ; les .html sont les fichiers de déploiement.
  RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]+\.html[?\s] [NC]
  RewriteRule ^(?!404\.html$)(.+)\.html$ /$1 [R=301,L]
  RewriteRule ^(presentation|expertiseservices|realisations|contact|confirmation)/$ /$1 [R=301,L]
  RewriteRule ^(realisations/[^/]+)/$ /$1 [R=301,L]

  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [END]

  # Une URL inconnue ou un asset manquant renvoie une vraie erreur 404.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . - [R=404,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_headers.c>
  # Protections du site statique, y compris les redirections et les erreurs.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set X-XSS-Protection "0"
  # Scripts locaux uniquement. Seul l'envoi Web3Forms peut sortir du site.
  # Aucun script ni bloc de style en ligne n'est autorisé.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; frame-src 'none'; form-action 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.web3forms.com"
  # Première activation limitée à 24 h, sur HTTPS et les deux hôtes vérifiés.
  # Aucun includeSubDomains/preload : les services mail ne sont pas dans ce périmètre.
  Header always set Strict-Transport-Security "max-age=86400" "expr=%{HTTPS} == 'on' && %{HTTP_HOST} =~ m#^(www\.)?ecgplusgn\.com(?::[0-9]+)?$#"

  # Les URL fixes doivent être vérifiées à chaque visite, y compris les icônes.
  # no-cache autorise le stockage et les réponses 304, sans garder une version périmée.
  <FilesMatch "\.(html|xml|txt|webmanifest|ico|png|jpe?g|gif|svg|avif|webp|woff2?|js|css)$">
    Header onsuccess unset Cache-Control
    Header always set Cache-Control "no-cache" "expr=%{REQUEST_STATUS} < 400"
  </FilesMatch>
  # Vite change le nom de ces fichiers dès que leur contenu change.
  # Ne jamais conserver un asset absent ou une erreur pendant un an.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?|webp|png|jpe?g|gif|svg|avif)$">
    Header always set Cache-Control "public, max-age=31536000, immutable" "expr=(%{REQUEST_STATUS} == 200 || %{REQUEST_STATUS} == 304) && %{REQUEST_URI} =~ m#^/assets/#"
  </FilesMatch>
  Header onsuccess unset Cache-Control "expr=%{REQUEST_STATUS} >= 400"
  Header always set Cache-Control "no-store" "expr=%{REQUEST_STATUS} >= 400"
</IfModule>
